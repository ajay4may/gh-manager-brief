#!/usr/bin/env bash
# gh-manager-brief — CxG-team agent for manager-ready briefs.
#
# Subcommands:
#   generate   Build briefs from a CSV of workshop attendees (original Day-3 flow).
#   event      Build a WorkIQ-grounded brief for an event you attended.
#   eval       Run the eval suite (offline, using fixtures).
#   help       Show this help.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cmd="${1:-help}"
shift || true

# Resolve python: prefer 'py -3' on Windows (Git Bash), else 'python3', else 'python'.
PY=""
if command -v py >/dev/null 2>&1; then PY="py -3";
elif command -v python3 >/dev/null 2>&1; then PY="python3";
elif command -v python >/dev/null 2>&1; then PY="python";
fi

print_help() {
  cat <<'EOF'
gh manager-brief — manager briefs for CxG

Subcommands:
  generate   Day-3 workshop briefs from a CSV
  event      WorkIQ-grounded brief for an event you attended
  eval       Run eval suite (offline, fixture-based)
  help       Show this help

Quick examples:
  gh manager-brief generate --input attendees.csv --out ./out
  gh manager-brief event --type offsite --name "CXG Americas Offsite" \
                         --from 2026-06-09 --to 2026-06-11
  gh manager-brief eval

Run any subcommand with --help for its own flags.
EOF
}

run_generate() {
  # ----- original Day-3 CSV flow -----
  local input="" out="./out" post_repo="" event="Workshop"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --input)      input="$2"; shift 2;;
      --out)        out="$2"; shift 2;;
      --post-issue) post_repo="$2"; shift 2;;
      --event)      event="$2"; shift 2;;
      -h|--help)
        echo "gh manager-brief generate --input <csv> [--out <dir>] [--post-issue OWNER/REPO] [--event <name>]"
        exit 0;;
      *) echo "Unknown flag: $1" >&2; exit 2;;
    esac
  done
  [[ -z "$input" ]] && { echo "Error: --input is required" >&2; exit 2; }
  [[ ! -f "$input" ]] && { echo "Error: input file not found: $input" >&2; exit 2; }
  mkdir -p "$out"

  tail -n +2 "$input" | while IFS=',' read -r handle name manager_email learned built committing ask; do
    [[ -z "${handle:-}" ]] && continue
    local file="$out/${handle}.md"
    cat > "$file" <<EOF
# Manager Brief — ${name}
**From:** @${handle}  **To:** ${manager_email}
**Event:** ${event}  **Date:** $(date +%Y-%m-%d)

> Send this to your manager. It captures what I worked on, what I'm
> committing to, and where I'd value your support.

## What I learned
${learned}

## What I built
${built}

## What I'm committing to (next 30 days)
${committing}

## How you can help
${ask}

---
*Generated by \`gh manager-brief\`.*
EOF
    echo "wrote $file"
    if [[ -n "$post_repo" ]]; then
      gh issue create --repo "$post_repo" --title "Manager brief — ${name} (${event})" \
                      --body-file "$file" --assignee "$handle" --label "manager-brief" >/dev/null \
        && echo "  ↳ posted issue in $post_repo (assignee: $handle)"
    fi
  done
  echo "done."
}

require_python() {
  if [[ -z "$PY" ]]; then
    echo "Error: python 3 not found in PATH. Install Python 3.9+ or 'py' launcher." >&2
    exit 3
  fi
}

case "$cmd" in
  help|-h|--help)
    print_help; exit 0;;
  generate)
    run_generate "$@";;
  event)
    require_python
    $PY "$SCRIPT_DIR/lib/event_brief.py" "$@";;
  eval)
    require_python
    $PY "$SCRIPT_DIR/eval/run_evals.py" "$@";;
  *)
    echo "Unknown command: $cmd" >&2
    print_help
    exit 2;;
esac
