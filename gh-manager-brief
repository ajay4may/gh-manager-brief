#!/usr/bin/env bash
# gh-manager-brief — generate end-of-Day-3 "send this to your manager" briefs
# Usage:
#   gh manager-brief generate --input attendees.csv --out ./out
#   gh manager-brief generate --input attendees.csv --out ./out --post-issue OWNER/REPO
#
# Input CSV columns (header required):
#   handle,name,manager_email,learned,built,committing,ask
#
# Output: one Markdown brief per attendee at <out>/<handle>.md
# Optional: when --post-issue is set, posts each brief as a GitHub issue
#           assigned to the attendee in the given repo.

set -euo pipefail

cmd="${1:-help}"; shift || true

print_help() {
  cat <<'EOF'
gh manager-brief — personalized end-of-Day-3 manager briefs

Commands:
  generate   Build briefs from a CSV of attendees
  help       Show this help

Flags (for generate):
  --input <path>          CSV file (required)
  --out <dir>             Output directory (default: ./out)
  --post-issue OWNER/REPO Post each brief as an issue in the given repo
  --event <name>          Event name for the brief header (default: "Workshop")

Examples:
  gh manager-brief generate --input attendees.csv --out ./out
  gh manager-brief generate --input attendees.csv --post-issue acme/ai-bootcamp
EOF
}

# -------- arg parsing --------
input=""; out="./out"; post_repo=""; event="Workshop"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --input)      input="$2"; shift 2;;
    --out)        out="$2"; shift 2;;
    --post-issue) post_repo="$2"; shift 2;;
    --event)      event="$2"; shift 2;;
    -h|--help)    print_help; exit 0;;
    *) echo "Unknown flag: $1" >&2; exit 2;;
  esac
done

case "$cmd" in
  help|-h|--help) print_help; exit 0;;
  generate) ;;
  *) echo "Unknown command: $cmd"; print_help; exit 2;;
esac

[[ -z "$input" ]] && { echo "Error: --input is required" >&2; exit 2; }
[[ ! -f "$input" ]] && { echo "Error: input file not found: $input" >&2; exit 2; }
mkdir -p "$out"

# -------- CSV → briefs --------
# Skip header, then loop rows.
count=0
tail -n +2 "$input" | while IFS=',' read -r handle name manager_email learned built committing ask; do
  [[ -z "${handle:-}" ]] && continue
  file="$out/${handle}.md"

  cat > "$file" <<EOF
# Manager Brief — ${name}
**From:** @${handle}  **To:** ${manager_email}
**Event:** ${event}  **Date:** $(date +%Y-%m-%d)

> Send this to your manager. It captures what I worked on, what I'm
> committing to, and where I'd value your support.

## What I learned
${learned}

## What I built
${built}

## What I'm committing to (next 30 days)
${committing}

## How you can help
${ask}

---
*Generated by \`gh manager-brief\`.*
EOF

  echo "wrote $file"
  count=$((count+1))

  if [[ -n "$post_repo" ]]; then
    title="Manager brief — ${name} (${event})"
    gh issue create \
      --repo "$post_repo" \
      --title "$title" \
      --body-file "$file" \
      --assignee "$handle" \
      --label "manager-brief" >/dev/null \
      && echo "  ↳ posted issue in $post_repo (assignee: $handle)"
  fi
done

echo "done."
